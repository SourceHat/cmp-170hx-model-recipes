  "definitions": {
    "backend_generation_tokens_per_second": "Accepted output tokens / unrounded sum of backend generation intervals. Queue and resume-prefill intervals are separate; displayed backend seconds are rounded.",
    "client_output_tokens_per_total_second": "Accepted output tokens / client request-send-to-stream-close seconds. Includes queue, prefill, generation, network and gateway overhead.",
    "client_first_progress_seconds": "Client send to first nonempty completion text, or first reasoning/text delta for Responses.",
    "same_generator_deliveries": "Identical captured monotonic delivery timestamps for both native requests.",
    "resumed_requests": "Submitted opt-in traces with at least one generation requeue; prefill-only rotations are counted separately by prefill_yields.",
    "ram_kv_token_slots": "floor(host KV budget MiB * 2^20 / aggregate main/draft page bytes) * 256; not guaranteed distinct history capacity."
  },
  "protocol": {
    "sampling": "temperature 0; native checks set min_tokens equal to max_tokens",
    "pair_output_budget_per_request": 256,
    "saturation_long_request_output_budget": 1536,
    "saturation_short_request_output_budget": 128,
    "saturation_submission": "slots + 1 synthetic long prompts, then a short prompt after physical slots fill",
    "context_qualification": "These maintenance checks do not qualify near-limit context or model quality."
  },
  "limitations": [
    "Ordinary production traffic and cache state were uncontrolled. Each wave is a single live check, not repeated independent measurements.",
    "Native completion and LiteLLM Responses prompts have different tokenization/chat wrapping. Do not interpret their difference as isolated gateway overhead.",
    "Freshly restarted caches, adaptive drafting and scheduling changes are confounded; these observations do not establish a causal before/after speedup.",
    "Short Responses requests can end incomplete at the deliberate token limit while emitting reasoning; event count is not output token count.",
    "Backend generation rates omit the additional queue/prefill intervals of a yielded request; client total rates expose those waits.",
    "Fairness adds resumable slot rotation. It does not add GPU replicas, KV capacity or attention bandwidth.",
    "Scheduler counter deltas and peak active/pending counts are engine-wide and can include ordinary production traffic; per-request rows and traces identify only the synthetic checks."
  ],
