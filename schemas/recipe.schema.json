{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CMP 170HX recipe metadata v1",
  "type": "object",
  "required": ["format_version", "id", "title", "model", "runtime", "hardware", "serving", "launch", "engine_config", "source_receipts", "benchmark_file"],
  "properties": {
    "format_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "title": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "required": ["hf_repo", "revision", "served_name", "quantization"],
      "properties": {
        "hf_repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "served_name": {"type": "string", "minLength": 1},
        "quantization": {"type": "string", "minLength": 1},
        "lineage": {
          "type": "object",
          "required": ["base_model", "post_trained_model", "developers", "post_training_method", "parent_checkpoint", "parent_revision", "model_card"],
          "properties": {
            "base_model": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
            "post_trained_model": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
            "developers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "post_training_method": {"type": "string", "minLength": 1},
            "parent_checkpoint": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
            "parent_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "model_card": {"type": "string", "pattern": "^https://huggingface\\.co/[^/]+/[^/]+/tree/[0-9a-f]{40}$"}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["id", "engine", "version"],
      "properties": {
        "id": {"enum": ["tabby", "apex-awq", "deepseek"]},
        "engine": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "hardware": {
      "type": "object",
      "required": ["card_count", "vram_gib_per_card", "architecture"],
      "properties": {
        "card_count": {"type": "integer", "minimum": 1},
        "vram_gib_per_card": {"type": "number", "exclusiveMinimum": 0},
        "architecture": {"type": "string"}
      }
    },
    "serving": {
      "type": "object",
      "required": ["context_tokens", "max_requests", "kv"],
      "properties": {
        "context_tokens": {"type": ["integer", "null"], "minimum": 1},
        "max_requests": {"type": "integer", "minimum": 1},
        "kv": {
          "type": "object",
          "required": ["shared_gpu_pool_tokens", "main_dtype", "draft_dtype"],
          "properties": {
            "shared_gpu_pool_tokens": {"type": ["integer", "null"], "minimum": 1},
            "main_dtype": {"type": ["string", "null"]},
            "draft_dtype": {"type": ["string", "null"]},
            "capacity_basis": {"type": "string", "enum": ["vllm_context_normalized_block_capacity"]},
            "capacity_context_tokens": {"type": "integer", "minimum": 1},
            "capacity_formula": {"type": "string"}
          }
        }
      }
    },
    "launch": {
      "type": "object",
      "required": ["argv", "environment"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "engine_config": {"type": "object"},
    "source_receipts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["file", "sha256", "kind"],
        "properties": {
          "file": {"type": "string", "pattern": "^[^/]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {"type": "string"}
        }
      }
    },
    "benchmark_file": {"const": "benchmarks.json"}
  }
}
